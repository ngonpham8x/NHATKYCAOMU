rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email.lower();
    }

    function isRootAdmin() {
      return isAuthenticated() && (
        getUserEmail() == 'tayninhdoimoi@gmail.com' ||
        getUserEmail() == 'ngonpham8x@gmail.com' ||
        getUserEmail() == 'bhttq3@gmail.com' ||
        getUserEmail() == 'ngocnt1091@gmail.com'
      );
    }

    function isAllowedAdmin() {
      return isAuthenticated() && (
        isRootAdmin() ||
        (
          exists(/databases/$(database)/documents/allowed_users/$(getUserEmail())) &&
          get(/databases/$(database)/documents/allowed_users/$(getUserEmail())).data.role == 'admin'
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDelegatedViewer(ownerUserId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(ownerUserId)) &&
        get(/databases/$(database)/documents/users/$(ownerUserId)).data.subEmails.hasAny([getUserEmail()]);
    }

    function canReadUserData(userId) {
      return isOwner(userId) || isAllowedAdmin() || isDelegatedViewer(userId);
    }

    // Allowed Users Collection (Access Whitelist)
    match /allowed_users/{emailDoc} {
      allow read: if isAllowedAdmin() || (isAuthenticated() && emailDoc == getUserEmail());
      allow create, update, delete: if isAuthenticated() && isAllowedAdmin();
    }

    // Access Requests Collection (Pending Authorization Requests)
    match /access_requests/{requestId} {
      allow read: if isAllowedAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.email == getUserEmail() &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAuthenticated() && isAllowedAdmin();
    }

    // User Profiles & Settings
    match /users/{userId} {
      allow read: if isOwner(userId) || isAllowedAdmin() || isDelegatedViewer(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId &&
        (request.resource.data.role != 'admin' || isAllowedAdmin());
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role;
      allow delete: if isAuthenticated() && isAllowedAdmin();
    }

    // Security Alerts Collection (Unauthorized Access Alerts for Admin)
    match /security_alerts/{alertId} {
      allow read: if isAllowedAdmin();
      allow create: if isAuthenticated() && request.resource.data.email == getUserEmail();
      allow update, delete: if isAuthenticated() && isAllowedAdmin();
    }

    // Backups Collection
    match /backups/{backupId} {
      allow read: if isAllowedAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && isAllowedAdmin();
    }

    // Harvest Records Collection
    match /harvest_records/{recordId} {
      allow read: if canReadUserData(resource.data.userId);
      
      // ONLY the record owner can create, update, or delete!
      // Admin and viewers are strictly READ-ONLY on other users' data.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
