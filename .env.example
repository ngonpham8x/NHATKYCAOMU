# Sao chép file này thành .env.local để chạy trên máy, hoặc đặt các biến này
# trong Vercel Project Settings → Environment Variables trước khi deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Để trống nếu Firestore dùng cơ sở dữ liệu mặc định (default).
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
